{
    "name": "@jahia/app-shell",
    "version": "3.4.0-SNAPSHOT",
    "scripts": {
        "build": "yarn webpack:appshell --mode=development",
        "prebuild:production": "yarn lint && yarn test",
        "build:production": "yarn webpack:appshell --mode=production",
        "webpack:appshell": "node --max_old_space_size=2048 ./node_modules/webpack/bin/webpack.js",
        "watch": "yarn webpack --watch",
        "clean": "rimraf *.log src/main/resources/javascript/apps",
        "clean:all": "yarn clean && rimraf node_modules node target",
        "lint": "oxlint --ignore-pattern 'tests/**'",
        "lint:fix": "oxlint --fix --ignore-pattern 'tests/**'",
        "test": "jest --ci --run-in-band --coverage --roots=src/",
        "tdd": "jest --watch",
        "sync-pom": "sync-pom-version --use-yarn"
    },
    "description": "Jahia app-shell - the heart of modularization and micro-front-end",
    "main": "index.js",
    "repository": "git@github.com:Jahia/app-shell.git",
    "author": "Jahia Core Team <core@jahia.com>",
    "license": "SEE LICENSE IN LICENSE.txt FILE",
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@apollo/react-components": "^3.1.5",
        "@jahia/design-system-kit": "^1.2.1",
        "@jahia/moonstone": "2.20.3",
        "@jahia/ui-extender": "^1.3.0",
        "formik": "^2.4.9",
        "graphql": "^15.10.2",
        "graphql-tag": "^2.12.7",
        "i18next": "^19.9.2",
        "i18next-xhr-backend": "^3.2.2",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-apollo": "^3.1.5",
        "react-dom": "^18.3.1",
        "react-i18next": "^11.18.6",
        "react-redux": "^9.3.0",
        "react-router": "^5.3.4",
        "redux": "^5.0.1",
        "redux-batched-actions": "^0.4.1",
        "redux-thunk": "^3.1.0",
        "subscriptions-transport-ws": "^0.11.0",
        "zen-observable": "^0.8.15"
    },
    "resolutions": {
        "cheerio": "1.0.0-rc.12"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-runtime": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/runtime": "^7.29.7",
        "@cyclonedx/webpack-plugin": "^3.17.0",
        "@jahia/test-framework": "^1.3.2",
        "babel-jest": "^28.1.3",
        "babel-loader": "^8.4.1",
        "clean-webpack-plugin": "^1.0.1",
        "css-loader": "^3.6.0",
        "file-loader": "^3.0.1",
        "jest": "^28.1.3",
        "jest-environment-jsdom": "^29.7.0",
        "oxlint": "^1.79.0",
        "rimraf": "^2.7.1",
        "source-map-loader": "^1.1.3",
        "style-loader": "^0.23.1",
        "sync-pom-version-to-package": "^1.6.1",
        "webpack": "^5.109.2",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^4.10.0"
    }
}
